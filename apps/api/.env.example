# Environment
NODE_ENV=development
PORT=3001

# Firebase/Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
GOOGLE_CLOUD_PROJECT=demo-reality-show
FIREBASE_PROJECT_ID=demo-reality-show
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIRESTORE_ENABLED=false

# Voting Configuration (ISO timestamp format)
VOTING_START_TIME=2026-05-19T00:33:00Z
VOTING_END_TIME=2026-05-22T20:00:00Z
MAX_VOTES_PER_IP=5

# Security
IP_SALT=EM2AYjZuW501ij6adI35hhnX6/qXJ91MC0fpnxDP7wk=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=8

# reCAPTCHA
TURNSTILE_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_ENABLED=false


# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug
